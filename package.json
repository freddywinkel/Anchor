{
  "name": "anchor",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.9.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8800 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8800 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "test:secondary": "node tests/verify-secondary.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:live": "node tests/verify-live.mjs",
    "audit:dependencies": "pnpm audit --prod",
    "test:update": "node tests/verify-update.mjs"
  },
  "dependencies": {
    "lucide-react": "0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
}
